@HostUri = http://localhost:5074

###
# group: Identity
# @name Token Generator
POST {{HostUri}}/token
Content-Type: application/json

{
  "userid": "d8566de3-b1a6-4a9b-b842-8e3887a82e41",
  "email": "someone@somedomain.com",
  "customClaims": {
    "admin": true,
    "trusted_member": true
  }
}

###
# group: Movies
# @name Create movie
POST {{HostUri}}/api/movies
Content-Type: application/json

{
  "Title": "Some movie name",
  "YearOfRelease": 2023,
  "Genres": [
    "Comedy"
  ]
}

###
# group: Movies
# @name Get movie
GET {{HostUri}}/api/movies/-- ADD ID HERE --

###
# group: Movies
# @name Get all movies
GET {{HostUri}}/api/movies

###
# group: Movies
# @name Update movie
PUT {{HostUri}}/api/movies/{id}
Content-Type: application/json

{
  "Title": "Some movie name",
  "YearOfRelease": 2023,
  "Genres": [
    "Comedy",
    "Action"
  ]
}

###
# group: Movies
# @name Delete movie
DELETE {{HostUri}}/api/movies/{id}

###
# group: Ratings
# @name Rate movie
PUT {{HostUri}}/api/movies/{id}/ratings
Content-Type: application/json

{
  "rating": 5
}

###
# group: Ratings
# @name Get my ratings
GET {{HostUri}}/api/ratings/me

###
# group: Ratings
# @name Delete rating
DELETE {{HostUri}}/api/movies/{id}/ratings